<?xml version="1.0" encoding="utf-8" ?>
<sqlMap>
	<resultMap id="user-with-roles" class="TMappedStatementGroupByUser" groupBy="user_id">
		<result property="Id" column="user_id"/>
		<result property="Name" column="user_name"/>
		<result property="Roles" resultMapping="user-role"/>
	</resultMap>

	<resultMap id="user-role" class="TMappedStatementGroupByRole">
		<result property="Name" column="role_name"/>
	</resultMap>

	<select id="GetUsersWithRoles" resultMap="user-with-roles">
		SELECT u.user_id, u.user_name, r.role_name
		FROM users u LEFT JOIN roles r ON r.user_id = u.user_id
	</select>
</sqlMap>
